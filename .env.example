# ==============================================================================
# MakGrill — copy to .env and adjust for your LAN
# ==============================================================================

# Shared secret for the dashboard (and the UI↔bridge internal API).
# Leave empty only for local development. The grill POST path never uses this.
MAKGRILL_SECRET=change-me

# Optional ntfy topic name (my-mak-grill) or a self-hosted URL.
# Can also be set from Settings in the UI.
NTFY_TOPIC=

# Timezone for container clocks / telemetry timestamps.
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO

# SQLite file (bridge writes here; mount ./data in Docker).
DATA_DIR=./data
DB_PATH=./data/cooks.db

# ------------------------------------------------------------------------------
# Local development (npm run dev)
# The bridge defaults to port 80 in Docker. On a laptop, use 8080.
# ------------------------------------------------------------------------------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8080
BRIDGE_URL=http://127.0.0.1:8080
WEB_PORT=3000

# ------------------------------------------------------------------------------
# Docker Compose — Standard bridge mode
# Grill DNS: makgrillsmobile.com → this machine's LAN IP, port 80.
# UI: http://LAN_IP/ (proxied by the bridge) or http://LAN_IP:3000
# ------------------------------------------------------------------------------
HOST_PORT=80

# When the web container is running, the bridge proxies all non-grill routes to it
# so Tailscale users only need port 80.
WEB_ORIGIN=http://web:3000

# ------------------------------------------------------------------------------
# Docker Compose — Macvlan mode (host already owns port 80)
# ------------------------------------------------------------------------------
CONTAINER_IP=192.168.0.95
PARENT_INTERFACE=eno1
SUBNET=192.168.0.0/24
GATEWAY=192.168.0.1
